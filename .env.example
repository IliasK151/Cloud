# Copy to .env and adjust. Real environment variables override this file.

# live = Binance (crypto) + Yahoo Finance (index futures, gold, oil, FX)
# sim  = everything simulated on an accelerated clock (works offline)
FEED=live

# Market-seconds per real second in sim mode (20 = one 1-minute bar every 3 seconds)
SIM_SPEED=20

# Dashboard port (bound to 127.0.0.1), the webhook-only port for TradingView (this Mac only,
# the tunnel forwards to it) and the isolated TradingView chart widget
PORT=3000
WEBHOOK_PORT=3001
# WIDGET_PORT=3002

# Open the floor from an iPad/phone on your home Wi-Fi: both lines are required.
# Other devices must sign in with the password; this Mac never has to.
# HOST=0.0.0.0
# FLOOR_PASSWORD=use-at-least-10-characters
# ALLOWED_HOSTS=my-mac.lan   # extra host names allowed to open the dashboard

# TradingView webhook secret (auto-generated into data/webhook-secret.txt if unset)
# WEBHOOK_SECRET=change-me

# MT5 bridge token for the MeridianBridge EA (auto-generated into data/bridge-token.txt if unset)
# BRIDGE_TOKEN=change-me

FUND_NAME=Meridian Capital
STARTING_CAPITAL=100000000

# Risk framework
RISK_PER_TRADE_PCT=0.5      # % of a desk's allocation risked per trade
DESK_DAILY_LOSS_PCT=2       # desk is halted for the day beyond this loss
FUND_DAILY_LOSS_PCT=1.2     # whole floor goes risk-off beyond this loss
MAX_LEVERAGE=4              # max gross notional per desk vs its allocation

# Set to 0 to stop the browser opening automatically
OPEN_BROWSER=1

# The Obsidian vault the floor writes (open the folder in Obsidian: "Open folder as vault").
# Default: data/vault. VAULT=0 turns it off.
# VAULT_DIR=~/Documents/Meridian Vault
